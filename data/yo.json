 "lectura": {
  "insights": [
   {
    "titulo": "Network ate Bentley's hours — the right trade, once",
    "dato": "7.0 h on Network against 4.0 planned",
    "por_que": "The Mexas dinner and this week's two first meetings came out of those hours. Bentley got 9.5 of 12, and the RIA draft is the first thing that breaks if it happens again."
   },
   {
    "titulo": "Your deep blocks happen before 9, or not at all",
    "dato": "14 of 19 real blocks started before 9:00",
    "por_que": "Afternoons went to meetings, transit and the phone. The 7:30–9:00 block on class days is the only one that survived every day; it is the one to protect."
   },
   {
    "titulo": "The phone is where the afternoon went",
    "dato": "71 pickups a day, half of them between 14:00 and 18:00",
    "por_que": "Same window your afternoon blocks died in. The phone is not the cause; it is where the lost time shows up, which makes it the easiest thing to measure."
   }
  ],
  "movida": {
   "que": "Lock 7:30–9:00 for the RIA draft, four mornings in a row",
   "cuando": "{{W+1}} to {{W+4}}, 7:30–9:00",
   "donde": "Library, second floor, before class",
   "hacer": "Phone in the bag, the rubric open, one section per morning. Four mornings is the whole draft.",
   "por_que": "It is the one block that survived every day this week, and the draft is due before the Grupo Ferra decision lands."
  },
